# Copy to .env.prod and fill in real values
# Never commit .env.prod to version control

SPRING_PROFILES_ACTIVE=prod

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=UserManagement
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_KID=current
JWT_PREVIOUS_SECRET=
JWT_PREVIOUS_KID=previous
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_MS=604800000

# Rate limiting (distributed in production)
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_SECONDS=60
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_TOKENS=10
RATE_LIMIT_AUTH_REFILL_SECONDS=60
